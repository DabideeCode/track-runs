{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__context7__*",
      "mcp__mobbin__*",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "claude-opus-5-5",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "effortLevel": "high"
}
